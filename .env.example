# Public site address (used for canonical links, sitemap and share previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.org

# Sanity CMS (people, photos, videos). Leave empty to use src/data/people.json
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Supabase (diyas, tribute messages, name submissions, contact)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox public token (pk.…), restricted to your domain in the Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=

# Password for /admin (moderation dashboard)
ADMIN_PASSWORD=
